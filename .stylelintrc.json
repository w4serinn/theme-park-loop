{
  "extends": "stylelint-config-standard",
  "rules": {
    "declaration-property-value-allowed-list": {
      "/^(color|background|background-color|border-color|border-top-color|border-right-color|border-bottom-color|border-left-color|outline-color|fill|stroke)$/": [
        "/^var\\(--/",
        "/^color-mix\\(.*var\\(--/",
        "/^none$/",
        "/^transparent$/",
        "/^inherit$/",
        "/^currentColor$/"
      ],
      "/^(border|border-top|border-right|border-bottom|border-left|outline)$/": [
        "/^none$/",
        "/^[0-9.]+(px|rem|em)?(\\s+(solid|dashed|dotted|double|groove|ridge|inset|outset|hidden))?(\\s+(var\\(--[\\w-]+\\)|color-mix\\(.*var\\(--[\\w-]+\\).*\\)))?$/"
      ]
    },
    "custom-property-empty-line-before": null,
    "selector-class-pattern": null,
    "property-disallowed-list": ["/^--/"]
  },
  "overrides": [
    {
      "comment": "新しいCSS変数(--で始まるカスタムプロパティ)を宣言できるのは styles/tokens.css だけに限定する。他のファイルではトップレベルの property-disallowed-list で禁止されているが、このファイルだけ例外的に解除する。docs/PALETTE.md で承認された色は、人間がこのファイルに追記してから使えるようになる。",
      "files": ["styles/tokens.css"],
      "rules": {
        "property-disallowed-list": null
      }
    }
  ]
}
